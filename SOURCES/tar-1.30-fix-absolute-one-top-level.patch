    With a good optimizing compiler, this is equivalent to (intmax_t) i
@@ -730,8 +733,8 @@ size_t blocking_write (int fd, void const *buf, size_t count);
 enum { BADFD = AT_FDCWD == -1 ? -2 : -1 };
 
